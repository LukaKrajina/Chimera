// chimera_dissipative.qk —— 量子耗散认知场
//
// 耗散/退相干是**可训练资源**（TQNF 法则 1：耗散-可训练性对偶律）。
// 用 POVM 弱测量注入可控退相干，耗散强度由 QMS 谱隙调制；
// 每个组件都是完整量子协议（态制备 → 门 → 纠缠 → 多 shot 测量 → 统计）。
//

// 工程化耗散门：退相干作为可训练门（耗散-可训练性对偶律）
@layer(time=0, thread=0, coord=(1000))
QObject dissipative_gate(QObject state, double rate, int32 model) {
    double gap = qk_qms_gap(model, rate, rate);
    if (gap < 0.0) { gap = 0.0; }
    double eps = 0.05 + 0.5 * (1.0 - gap);
    auto anc = new QuantumRegister(1);
    qgate_h(anc, 0);
    qgate_cnot_pair(state, 0, anc, 0);
    qgate_rz(anc, 0, eps);
    qgate_cnot_pair(state, 0, anc, 0);
    qgate_h(anc, 0);
    int32 _ = anc.measure();
    return state;
}

// 振幅阻尼层：能量弛豫式信息遗忘（信道 model=2）
@layer(time=0, thread=0, coord=(1001))
QObject amplitude_damping_layer(QObject state, double gamma) {
    double gap = qk_qms_gap(2, gamma, gamma);
    if (gap < 0.0) { gap = 0.0; }
    double relax = gamma * (1.0 - gap);
    int32 n = qobj_num_qubits(state);
    int32 i = 0;
    while (i < n) {
        auto anc = new QuantumRegister(1);
        qgate_cnot_pair(state, i, anc, 0);
        qgate_rz(anc, 0, relax);
        qgate_cnot_pair(state, i, anc, 0);
        int32 _ = anc.measure();
        i = i + 1;
    }
    return state;
}

// 退相注意力：score 编码成量子态 → 退相弱测量 → 多 shot 读出注意力分数
@layer(time=0, thread=0, coord=(1002))
double dephasing_attention(double score, double dephase) {
    double gap = qk_qms_gap(1, dephase, dephase);
    if (gap < 0.0) { gap = 0.0; }
    double temp = 0.05 + gap;
    auto signal = basis_state(score * PI!(), 0.0, 0);
    auto anc = new QuantumRegister(1);
    qgate_h(anc, 0);
    qgate_cnot_pair(signal, 0, anc, 0);
    qgate_rz(anc, 0, dephase);
    qgate_cnot_pair(signal, 0, anc, 0);
    qgate_h(anc, 0);
    int32 _a = anc.measure();
    double z = 0.0;
    int32 s = 0;
    while (s < 8) {
        z = z + qexpect_z(signal, 0);
        s = s + 1;
    }
    int32 _c = signal.measure();
    z = z / 8.0;
    return boltzmann2(z, 0.0, 1.0 / temp);
}

// 去极化 Dropout：量子 Dropout（信道 model=0）
@layer(time=0, thread=0, coord=(1003))
QObject depolarizing_dropout(QObject state, double p) {
    double keep = 1.0 - p;
    if (keep < 0.0) { keep = 0.0; }
    int32 n = qobj_num_qubits(state);
    int32 i = 0;
    while (i < n) {
        qgate_rz(state, i, keep * 0.1 * (1.0 + 0.05 * i));
        i = i + 1;
    }
    if (p > 0.5) {
        int32 _ = qmeasure(state, 0);
    }
    return state;
}

// Kraus 信道步：真正的 Kraus 信道演化（K0 保持 + K1 退相按 mix_ratio 混合）
@layer(time=0, thread=0, coord=(1004))
QObject kraus_step(QObject state, double gap, double mix_ratio) {
    if (gap < 0.0) { gap = 0.0; }
    int32 n = qobj_num_qubits(state);
    int32 i = 0;
    while (i < n) {
        qgate_rz(state, i, gap * (1.0 - mix_ratio));   // K0（保持）
        auto anc = new QuantumRegister(1);
        qgate_h(anc, 0);
        qgate_cnot_pair(state, i, anc, 0);
        qgate_rz(anc, 0, gap * mix_ratio);
        qgate_cnot_pair(state, i, anc, 0);
        qgate_h(anc, 0);
        int32 _ = anc.measure();                        // K1（退相）测量
        i = i + 1;
    }
    return state;
}

// 耗散率自适应优化：有限差分把耗散率收敛到目标谱隙（混沌边缘的耗散对偶）
@layer(time=0, thread=0, coord=(1005))
double dissipation_rate_opt(double rate, int32 model, double target_gap) {
    double h = 0.01;
    double g0 = qk_qms_gap(model, rate, rate);
    double gp = qk_qms_gap(model, rate + h, rate + h);
    double gm = qk_qms_gap(model, rate - h, rate - h);
    double grad = (gp - gm) / (2.0 * h);
    double new_rate = rate - 0.1 * 2.0 * (g0 - target_gap) * grad;
    if (new_rate < 0.0) { new_rate = 0.0; }
    if (new_rate > 1.0) { new_rate = 1.0; }
    return new_rate;
}

// 噪声残差：残差连接 + 注入受控噪声（DQNN 梯度标度受控）
@layer(time=0, thread=0, coord=(1006))
QObject noisy_residual(QObject x, double alpha, double noise) {
    int32 n = qobj_num_qubits(x);
    int32 i = 0;
    while (i < n) {
        qgate_rz(x, i, alpha * 0.5);
        i = i + 1;
    }
    double gap = qk_qms_gap(0, noise, noise);
    if (gap < 0.0) { gap = 0.0; }
    if (noise > 0.3) {
        int32 _ = qmeasure(x, 0);
    }
    int32 j = 0;
    while (j < n - 1) {
        qgate_cnot(x, j, j + 1);
        j = j + 1;
    }
    return x;
}

// 噪声工程路由：把信号态按曲率路由到退相/去极化双信道弱测量
@layer(time=0, thread=0, coord=(1007))
double engineered_noise_router(double signal, double temperature) {
    double g = hyperbolic_metric(signal);
    if (g > 100.0) { g = 100.0; }
    double route_weight = boltzmann2(1.0, 0.0, g / temperature);
    auto state = basis_state(signal * PI!(), 0.0, 0);
    double acc = 0.0;
    int32 s = 0;
    while (s < 8) {
        auto anc = new QuantumRegister(1);
        qgate_h(anc, 0);
        qgate_cnot_pair(state, 0, anc, 0);
        qgate_rz(anc, 0, route_weight * 0.4);
        qgate_cnot_pair(state, 0, anc, 0);
        qgate_h(anc, 0);
        int32 _a = anc.measure();
        acc = acc + qexpect_z(state, 0);
        s = s + 1;
    }
    int32 _c = state.measure();
    acc = acc / 8.0;
    double gap_dep = qk_qms_gap(1, 0.2, 0.2);
    double gap_depol = qk_qms_gap(0, 0.2, 0.2);
    return acc * (route_weight * gap_dep + (1.0 - route_weight) * gap_depol);
}