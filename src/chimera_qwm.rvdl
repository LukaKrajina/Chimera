// chimera_qwm.rvdl —— ② 生成式世界模型（Quantum Generative World Model）
//
// 纯新增模块，不修改任何现有 .rvdl。理论见 docs/quantum-cognition-theory.md §4。
// C++ 权威实现：Ravendrel/runtime/include/qai/GenerativeWorldModel.hpp
// 补齐 chimera_dream.rvdl:15 自注列的「显式轨迹缓冲 / 反事实对照」缺口在语言层的公式侧。

// 定理 3：Bures 距离上界 D_B ≤ k·ε_U + ε_M（线性累积，非指数）
@layer(time=0, thread=0, coord=(1410))
export double qwm_bures_bound(double steps, double eps_u, double eps_m) {
    return steps * eps_u + eps_m;
}

// F = cos²(D_B/2) 的二次下界（钳到 [0,1]）
@layer(time=0, thread=0, coord=(1411))
export double qwm_fidelity_bound(double steps, double eps_u, double eps_m) {
    double db = qwm_bures_bound(steps, eps_u, eps_m);
    double f = 1.0 - 0.25 * db * db;
    if (f < 0.0) { f = 0.0; }
    return f;
}

// Newton 迭代求 sqrt（rvdl 无内置 sqrt；12 步对 [0,1] 足够）
@layer(time=0, thread=0, coord=(1412))
export double qwm_sqrt(double x) {
    if (x <= 0.0) { return 0.0; }
    double y = x;
    if (y > 1.0) { y = 1.0; }
    int32 i = 0;
    while (i < 12) {
        y = 0.5 * (y + x / y);
        i = i + 1;
    }
    return y;
}

// 给定容错 δ 可安全想象的步数：k_max = (2√δ − ε_M)/ε_U
@layer(time=0, thread=0, coord=(1413))
export double qwm_safe_horizon(double delta, double eps_u, double eps_m) {
    if (eps_u <= 0.0) { return 1000000.0; }
    double k = (2.0 * qwm_sqrt(delta) - eps_m) / eps_u;
    if (k < 0.0) { k = 0.0; }
    return k;
}

// 量子 ELBO 的单步可计算项：log p(o|s) + log F 的多项式代理（单调一致）
@layer(time=0, thread=0, coord=(1414))
export double qwm_elbo_term(double likelihood, double model_fidelity) {
    double p = likelihood;
    double f = model_fidelity;
    if (p < 0.000001) { p = 0.000001; }
    if (f < 0.000001) { f = 0.000001; }
    return -(1.0 - p) - (1.0 - f);
}

// 反事实对照：两条轨迹末态的差异（0=完全发散，1=完全一致）
@layer(time=0, thread=0, coord=(1415))
export double qwm_counterfactual_gap(double fidelity_factual, double fidelity_alternative) {
    double d = fidelity_factual - fidelity_alternative;
    if (d < 0.0) { d = -d; }
    return 1.0 - d;
}
