// ═══════════════════════════════════════════════════════════════════════════════
// chimera_morphs.qk —— 态射宏库
// ═══════════════════════════════════════════════════════════════════════════════

// 圆周率 π —— 相位编码的单位（布洛赫球一整转）
morph PI() { 3.14159265358979 }

// π/2 —— 90°（辛流 / 哈密顿流的四分之一转）
morph HALF_PI() { 1.57079632679490 }

// π/4 —— 45°（S / T 门相位、ffn 非线性旋转）
morph QUARTER_PI() { 0.78539816339745 }

// 黄金比 φ = (1+√5)/2 —— 混沌漂移主旋转角（有序 / 混沌边缘的几何序参量）
morph GOLDEN_RATIO() { 1.61803398874989 }

// 白银比 1+√2 —— 混沌漂移第二旋转角（非共振角，避免与 φ 共振锁相）
morph SILVER_RATIO() { 2.41421356237310 }

// ln 2 —— 自然对数 2（信息论容量的自然单位）
morph LN2() { 0.69314718055995 }

// ───────────────────────────────────────────────────────────────────────────────
// 二、超参数态射（采样 / 学习 / 数值稳定）
//    这些是「工程超参数」的规范定义：采样数、学习率、差分步长、数值稳定下界、
//    度规截断、噪声阈值等，集中定义、统一语义，避免每个组件各写各的魔法数字。
// ───────────────────────────────────────────────────────────────────────────────

// 采样 shot 数 —— 多 shot 统计估计（qattention / qexpect_z / qstate_* 的采样次数）
morph SHOTS() { 8 }

// tanh 量化级数 —— tanh_quantize(act, 1.0, N) 的离散层级 N
morph TANH_LEVELS() { 8 }

// 学习率基值 —— 自然梯度 / QRL / 元学习 / 反射学习的学习率
morph LR_BASE() { 0.05 }

// 相位扰动步长 —— 逐 qubit 的 0.1*i 相位微扰（测地线 / 卷积的相位增量）
morph PHASE_STEP() { 0.1 }

// 有限差分步长 h —— 梯度 / 谱隙 / 漂移步长的差分微扰
morph DIFF_H() { 0.01 }

// 数值稳定下界 eps —— 度规伪逆 / 概率的防零下界
morph EPS() { 0.000001 }

// 度规截断上限 —— 双曲度规 / 权重的发散截断
morph METRIC_CAP() { 100.0 }

// QMS 去相位谱隙率 —— qk_qms_gap(1, 0.2, 0.2) 的去相位率
morph QMS_GAP_RATE() { 0.2 }

// 噪声阈值 —— 退相 / 去极化的注入阈值
morph NOISE_THRESHOLD() { 0.3 }

// 耦合步长 —— 路由权重 → 相位的耦合系数
morph COUPLING_STEP() { 0.4 }

// 裁剪下界 —— 权重 / 角度的规范化下界
morph CLIP_LOW() { -1.0 }

// 裁剪上界 —— 权重 / 角度的规范化上界
morph CLIP_HIGH() { 1.0 }

// ───────────────────────────────────────────────────────────────────────────────
// 三、参数化态射（真正的「态射」：标量 → 标量变换）
//    这些是「从标量到标量」的态射：把「标量缩放为相位 / 黄金比 / 白银比」这类
//    反复出现的变换，抽象为可组合的命名态射（source 对象 → target 对象）。
// ───────────────────────────────────────────────────────────────────────────────

// 相位编码态射：标量 → π 标度相位（布洛赫球编码单位）
morph phase_encode($x: expr) { ($x) * 3.14159265358979 }

// 黄金比缩放态射：标量 → φ 倍（混沌 / 几何的黄金标度）
morph golden_scale($x: expr) { ($x) * 1.61803398874989 }

// 白银比缩放态射：标量 → (1+√2) 倍
morph silver_scale($x: expr) { ($x) * 2.41421356237310 }

// π/2 缩放态射：标量 → (π/2) 倍（辛流 / 哈密顿流的四分之一转）
morph half_pi_scale($x: expr) { ($x) * 1.57079632679490 }