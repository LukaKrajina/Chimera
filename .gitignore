# ─────────────────────────────────────────────────────────────────────────────
# Chimera .gitignore —— 过滤生成物与缓存
# ─────────────────────────────────────────────────────────────────────────────

# ── Python 缓存与虚拟环境 ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ── rvdl / Ravendrel 生成物与缓存 ──
.rvdl-cache/
*.rvdli
*.ll
*.bc
*.o
*.obj

# ── CARLA 运行产物（录制回放、日志、临时输出）──
carla/recordings/
carla/_out/
carla/out/
*.log

# ── 编辑器 / IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── 构建产物与依赖 ──
build/
dist/
node_modules/
target/
out/

# ── 系统 / 平台文件 ──
.DS_Store
Thumbs.db
desktop.ini