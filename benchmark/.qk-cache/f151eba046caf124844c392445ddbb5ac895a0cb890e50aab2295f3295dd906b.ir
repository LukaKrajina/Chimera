define %QObject* @chaos_drift(%QObject* %arg0, double %arg1) {
entry:
 %consciousness_ptr = alloca %QObject*
 %dt_ptr = alloca double
 store %QObject* %arg0, %QObject** %consciousness_ptr
 store double %arg1, double* %dt_ptr
 %1 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %1, i32 0)
 %2 = load %QObject*, %QObject** %consciousness_ptr
 %3 = load double, double* %dt_ptr
 %4 = fmul double %3, 1.61803398874989
 call void @qk_qgate_rz(%QObject* %2, i32 0, double %4)
 %5 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %5, i32 0)
 %6 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %6, i32 1)
 %7 = load %QObject*, %QObject** %consciousness_ptr
 %8 = load double, double* %dt_ptr
 %9 = fmul double %8, 1.61803398874989
 call void @qk_qgate_rz(%QObject* %7, i32 1, double %9)
 %10 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %10, i32 1)
 %11 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_cnot(%QObject* %11, i32 0, i32 1)
 %12 = load %QObject*, %QObject** %consciousness_ptr
 %13 = load double, double* %dt_ptr
 %14 = fmul double %13, 2.4142135623731
 call void @qk_qgate_rz(%QObject* %12, i32 1, double %14)
 %15 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_cnot(%QObject* %15, i32 0, i32 1)
 %16 = load %QObject*, %QObject** %consciousness_ptr
 ret %QObject* %16
}

define %form.EmotionReading* @measure_emotion(%QObject* %arg0) {
entry:
 %consciousness_ptr = alloca %QObject*
 %b0_ptr_1 = alloca i32
 %b1_ptr_2 = alloca i32
 %form_obj_5 = alloca %form.EmotionReading
 %r_ptr_3 = alloca %form.EmotionReading*
 store %QObject* %arg0, %QObject** %consciousness_ptr
 %1 = load %QObject*, %QObject** %consciousness_ptr
 %2 = call i32 @qk_qmeasure(%QObject* %1, i32 0)
 store i32 %2, i32* %b0_ptr_1
 %3 = load %QObject*, %QObject** %consciousness_ptr
 %4 = call i32 @qk_qmeasure(%QObject* %3, i32 1)
 store i32 %4, i32* %b1_ptr_2
 store %form.EmotionReading* %form_obj_5, %form.EmotionReading** %r_ptr_3
 %6 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_3
 %7 = load i32, i32* %b0_ptr_1
 %8 = mul i32 %7, 2
 %9 = load i32, i32* %b1_ptr_2
 %10 = add i32 %8, %9
 %11 = getelementptr %form.EmotionReading, %form.EmotionReading* %6, i32 0, i32 1
 store i32 %10, i32* %11
 %12 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_3
 %13 = load %QObject*, %QObject** %consciousness_ptr
 %14 = getelementptr %form.EmotionReading, %form.EmotionReading* %12, i32 0, i32 2
 store %QObject* %13, %QObject** %14
 %15 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_3
 ret %form.EmotionReading* %15
}

define %form.WeakReading* @weak_measure(%QObject* %arg0, i32 %arg1, double %arg2) {
entry:
 %consciousness_ptr = alloca %QObject*
 %qubit_idx_ptr = alloca i32
 %eps_ptr = alloca double
 %anc_ptr_4 = alloca %QObject*
 %res_ptr_5 = alloca i32
 %form_obj_14 = alloca %form.WeakReading
 %r_ptr_6 = alloca %form.WeakReading*
 store %QObject* %arg0, %QObject** %consciousness_ptr
 store i32 %arg1, i32* %qubit_idx_ptr
 store double %arg2, double* %eps_ptr
 %1 = call %QObject* @qk_create_QuantumRegister(i32 1)
 store %QObject* %1, %QObject** %anc_ptr_4
 %2 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_qgate_h(%QObject* %2, i32 0)
 %3 = load %QObject*, %QObject** %consciousness_ptr
 %4 = load i32, i32* %qubit_idx_ptr
 %5 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_qgate_cnot_pair(%QObject* %3, i32 %4, %QObject* %5, i32 0)
 %6 = load %QObject*, %QObject** %anc_ptr_4
 %7 = load double, double* %eps_ptr
 call void @qk_qgate_rz(%QObject* %6, i32 0, double %7)
 %8 = load %QObject*, %QObject** %consciousness_ptr
 %9 = load i32, i32* %qubit_idx_ptr
 %10 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_qgate_cnot_pair(%QObject* %8, i32 %9, %QObject* %10, i32 0)
 %11 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_qgate_h(%QObject* %11, i32 0)
 %12 = load %QObject*, %QObject** %anc_ptr_4
 %13 = call i32 @qk_measure_object(%QObject* %12)
 store i32 %13, i32* %res_ptr_5
 store %form.WeakReading* %form_obj_14, %form.WeakReading** %r_ptr_6
 %15 = load %form.WeakReading*, %form.WeakReading** %r_ptr_6
 %16 = load i32, i32* %res_ptr_5
 %17 = getelementptr %form.WeakReading, %form.WeakReading* %15, i32 0, i32 1
 store i32 %16, i32* %17
 %18 = load %form.WeakReading*, %form.WeakReading** %r_ptr_6
 %19 = load %QObject*, %QObject** %consciousness_ptr
 %20 = getelementptr %form.WeakReading, %form.WeakReading* %18, i32 0, i32 2
 store %QObject* %19, %QObject** %20
 %21 = load %form.WeakReading*, %form.WeakReading** %r_ptr_6
 %22 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_release_object(%QObject* %22)
 ret %form.WeakReading* %21
}

define double @chaos_richness(double %arg0, i32 %arg1) {
entry:
 %dt_ptr = alloca double
 %steps_ptr = alloca i32
 %n0_ptr_7 = alloca i32
 %n1_ptr_8 = alloca i32
 %n2_ptr_9 = alloca i32
 %n3_ptr_10 = alloca i32
 %shots_ptr_11 = alloca i32
 %s_ptr_16 = alloca i32
 %psi_ptr_17 = alloca %QObject*
 %i_ptr_22 = alloca i32
 %b0_ptr_23 = alloca i32
 %b1_ptr_24 = alloca i32
 %st_ptr_25 = alloca i32
 store double %arg0, double* %dt_ptr
 store i32 %arg1, i32* %steps_ptr
 store i32 0, i32* %n0_ptr_7
 store i32 0, i32* %n1_ptr_8
 store i32 0, i32* %n2_ptr_9
 store i32 0, i32* %n3_ptr_10
 store i32 8, i32* %shots_ptr_11
 store i32 0, i32* %s_ptr_16
 br label %for_cond_12

for_cond_12:
 %1 = load i32, i32* %s_ptr_16
 %2 = load i32, i32* %shots_ptr_11
 %3 = icmp slt i32 %1, %2
 br i1 %3, label %for_body_13, label %for_after_15

for_body_13:
 %4 = call %QObject* @qk_create_QuantumRegister(i32 2)
 store %QObject* %4, %QObject** %psi_ptr_17
 store i32 0, i32* %i_ptr_22
 br label %for_cond_18

for_cond_18:
 %5 = load i32, i32* %i_ptr_22
 %6 = load i32, i32* %steps_ptr
 %7 = icmp slt i32 %5, %6
 br i1 %7, label %for_body_19, label %for_after_21

for_body_19:
 %8 = load %QObject*, %QObject** %psi_ptr_17
 %9 = load double, double* %dt_ptr
 %10 = call %QObject* @chaos_drift(%QObject* %8, double %9)
 store %QObject* %10, %QObject** %psi_ptr_17
 br label %for_update_20

for_update_20:
 %11 = load i32, i32* %i_ptr_22
 %12 = add i32 %11, 1
 store i32 %12, i32* %i_ptr_22
 br label %for_cond_18

for_after_21:
 %13 = load %QObject*, %QObject** %psi_ptr_17
 %14 = call i32 @qk_qmeasure(%QObject* %13, i32 0)
 store i32 %14, i32* %b0_ptr_23
 %15 = load %QObject*, %QObject** %psi_ptr_17
 %16 = call i32 @qk_qmeasure(%QObject* %15, i32 1)
 store i32 %16, i32* %b1_ptr_24
 %17 = load i32, i32* %b0_ptr_23
 %18 = mul i32 %17, 2
 %19 = load i32, i32* %b1_ptr_24
 %20 = add i32 %18, %19
 store i32 %20, i32* %st_ptr_25
 %21 = load i32, i32* %st_ptr_25
 %22 = icmp eq i32 %21, 0
 br i1 %22, label %if_then_26, label %if_after_28

if_then_26:
 %23 = load i32, i32* %n0_ptr_7
 %24 = add i32 %23, 1
 store i32 %24, i32* %n0_ptr_7
 br label %if_after_28

if_after_28:
 %25 = load i32, i32* %st_ptr_25
 %26 = icmp eq i32 %25, 1
 br i1 %26, label %if_then_29, label %if_after_31

if_then_29:
 %27 = load i32, i32* %n1_ptr_8
 %28 = add i32 %27, 1
 store i32 %28, i32* %n1_ptr_8
 br label %if_after_31

if_after_31:
 %29 = load i32, i32* %st_ptr_25
 %30 = icmp eq i32 %29, 2
 br i1 %30, label %if_then_32, label %if_after_34

if_then_32:
 %31 = load i32, i32* %n2_ptr_9
 %32 = add i32 %31, 1
 store i32 %32, i32* %n2_ptr_9
 br label %if_after_34

if_after_34:
 %33 = load i32, i32* %st_ptr_25
 %34 = icmp eq i32 %33, 3
 br i1 %34, label %if_then_35, label %if_after_37

if_then_35:
 %35 = load i32, i32* %n3_ptr_10
 %36 = add i32 %35, 1
 store i32 %36, i32* %n3_ptr_10
 br label %if_after_37

if_after_37:
 %37 = load %QObject*, %QObject** %psi_ptr_17
 call void @qk_release_object(%QObject* %37)
 br label %for_update_14

for_update_14:
 %38 = load i32, i32* %s_ptr_16
 %39 = add i32 %38, 1
 store i32 %39, i32* %s_ptr_16
 br label %for_cond_12

for_after_15:
 %40 = load i32, i32* %n0_ptr_7
 %41 = load i32, i32* %n1_ptr_8
 %42 = load i32, i32* %n2_ptr_9
 %43 = load i32, i32* %n3_ptr_10
 %44 = call double @qk_shannon4(i32 %40, i32 %41, i32 %42, i32 %43)
 ret double %44
}

define i32 @probe_one(double %arg0, i32 %arg1) {
entry:
 %dt_ptr = alloca double
 %nsteps_ptr = alloca i32
 %c0_ptr_38 = alloca i32
 %c1_ptr_39 = alloca i32
 %c2_ptr_40 = alloca i32
 %c3_ptr_41 = alloca i32
 %t_ptr_42 = alloca i32
 %reg_ptr_46 = alloca %QObject*
 %s_ptr_47 = alloca i32
 %b0_ptr_51 = alloca i32
 %b1_ptr_52 = alloca i32
 %st_ptr_53 = alloca i32
 %ent_ptr_66 = alloca double
 %es_ptr_67 = alloca i32
 store double %arg0, double* %dt_ptr
 store i32 %arg1, i32* %nsteps_ptr
 store i32 0, i32* %c0_ptr_38
 store i32 0, i32* %c1_ptr_39
 store i32 0, i32* %c2_ptr_40
 store i32 0, i32* %c3_ptr_41
 store i32 0, i32* %t_ptr_42
 br label %while_cond_43

while_cond_43:
