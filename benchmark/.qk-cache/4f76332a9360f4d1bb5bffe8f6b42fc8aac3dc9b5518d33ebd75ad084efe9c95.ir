%form.EmotionPolicy = type { i8*, double, double, double, double }
%form.ErrorReading = type { i8*, double, double, i32 }

@.str.1 = private unnamed_addr constant [23 x i8] c"METRIC chimera_entropy\00", align 1
@.str.2 = private unnamed_addr constant [30 x i8] c"METRIC chimera_setpoint_iters\00", align 1
@.str.3 = private unnamed_addr constant [28 x i8] c"METRIC chimera_setpoint_err\00", align 1
@.str.4 = private unnamed_addr constant [32 x i8] c"METRIC chimera_error_detect_acc\00", align 1

