define %QObject* @chaos_drift(%QObject* %arg0, double %arg1) {
entry:
 %consciousness_ptr = alloca %QObject*
 %dt_ptr = alloca double
 store %QObject* %arg0, %QObject** %consciousness_ptr
 store double %arg1, double* %dt_ptr
 %1 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %1, i32 0)
 %2 = load %QObject*, %QObject** %consciousness_ptr
 %3 = load double, double* %dt_ptr
 %4 = fmul double %3, 1.61803398874989
 call void @qk_qgate_rz(%QObject* %2, i32 0, double %4)
 %5 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %5, i32 0)
 %6 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %6, i32 1)
 %7 = load %QObject*, %QObject** %consciousness_ptr
 %8 = load double, double* %dt_ptr
 %9 = fmul double %8, 1.61803398874989
 call void @qk_qgate_rz(%QObject* %7, i32 1, double %9)
 %10 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %10, i32 1)
 %11 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_cnot(%QObject* %11, i32 0, i32 1)
 %12 = load %QObject*, %QObject** %consciousness_ptr
 %13 = load double, double* %dt_ptr
 %14 = fmul double %13, 2.4142135623731
 call void @qk_qgate_rz(%QObject* %12, i32 1, double %14)
 %15 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_cnot(%QObject* %15, i32 0, i32 1)
 %16 = load %QObject*, %QObject** %consciousness_ptr
 ret %QObject* %16
}

define %form.EmotionReading* @measure_emotion(%QObject* %arg0) {
entry:
 %consciousness_ptr = alloca %QObject*
 %b0_ptr_1 = alloca i32
 %b1_ptr_2 = alloca i32
 %form_obj_5 = alloca %form.EmotionReading
 %r_ptr_3 = alloca %form.EmotionReading*
 store %QObject* %arg0, %QObject** %consciousness_ptr
 %1 = load %QObject*, %QObject** %consciousness_ptr
 %2 = call i32 @qk_qmeasure(%QObject* %1, i32 0)
 store i32 %2, i32* %b0_ptr_1
 %3 = load %QObject*, %QObject** %consciousness_ptr
 %4 = call i32 @qk_qmeasure(%QObject* %3, i32 1)
 store i32 %4, i32* %b1_ptr_2
 store %form.EmotionReading* %form_obj_5, %form.EmotionReading** %r_ptr_3
 %6 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_3
 %7 = load i32, i32* %b0_ptr_1
 %8 = mul i32 %7, 2
 %9 = load i32, i32* %b1_ptr_2
 %10 = add i32 %8, %9
 %11 = getelementptr %form.EmotionReading, %form.EmotionReading* %6, i32 0, i32 1
 store i32 %10, i32* %11
 %12 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_3
 %13 = load %QObject*, %QObject** %consciousness_ptr
 %14 = getelementptr %form.EmotionReading, %form.EmotionReading* %12, i32 0, i32 2
 store %QObject* %13, %QObject** %14
 %15 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_3
 ret %form.EmotionReading* %15
}

define %form.WeakReading* @weak_measure(%QObject* %arg0, i32 %arg1, double %arg2) {
entry:
 %consciousness_ptr = alloca %QObject*
 %qubit_idx_ptr = alloca i32
 %eps_ptr = alloca double
 %anc_ptr_4 = alloca %QObject*
 %res_ptr_5 = alloca i32
 %form_obj_14 = alloca %form.WeakReading
 %r_ptr_6 = alloca %form.WeakReading*
 store %QObject* %arg0, %QObject** %consciousness_ptr
 store i32 %arg1, i32* %qubit_idx_ptr
 store double %arg2, double* %eps_ptr
 %1 = call %QObject* @qk_create_QuantumRegister(i32 1)
 store %QObject* %1, %QObject** %anc_ptr_4
 %2 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_qgate_h(%QObject* %2, i32 0)
 %3 = load %QObject*, %QObject** %consciousness_ptr
 %4 = load i32, i32* %qubit_idx_ptr
 %5 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_qgate_cnot_pair(%QObject* %3, i32 %4, %QObject* %5, i32 0)
 %6 = load %QObject*, %QObject** %anc_ptr_4
 %7 = load double, double* %eps_ptr
 call void @qk_qgate_rz(%QObject* %6, i32 0, double %7)
 %8 = load %QObject*, %QObject** %consciousness_ptr
 %9 = load i32, i32* %qubit_idx_ptr
 %10 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_qgate_cnot_pair(%QObject* %8, i32 %9, %QObject* %10, i32 0)
 %11 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_qgate_h(%QObject* %11, i32 0)
 %12 = load %QObject*, %QObject** %anc_ptr_4
 %13 = call i32 @qk_measure_object(%QObject* %12)
 store i32 %13, i32* %res_ptr_5
 store %form.WeakReading* %form_obj_14, %form.WeakReading** %r_ptr_6
 %15 = load %form.WeakReading*, %form.WeakReading** %r_ptr_6
 %16 = load i32, i32* %res_ptr_5
 %17 = getelementptr %form.WeakReading, %form.WeakReading* %15, i32 0, i32 1
 store i32 %16, i32* %17
 %18 = load %form.WeakReading*, %form.WeakReading** %r_ptr_6
 %19 = load %QObject*, %QObject** %consciousness_ptr
 %20 = getelementptr %form.WeakReading, %form.WeakReading* %18, i32 0, i32 2
 store %QObject* %19, %QObject** %20
 %21 = load %form.WeakReading*, %form.WeakReading** %r_ptr_6
 %22 = load %QObject*, %QObject** %anc_ptr_4
 call void @qk_release_object(%QObject* %22)
 ret %form.WeakReading* %21
}

define %form.EmotionPolicy* @init_policy() {
entry:
 %form_obj_1 = alloca %form.EmotionPolicy
 %p_ptr_7 = alloca %form.EmotionPolicy*
 store %form.EmotionPolicy* %form_obj_1, %form.EmotionPolicy** %p_ptr_7
 %2 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_7
 %3 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %2, i32 0, i32 1
 store double 0.5, double* %3
 %4 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_7
 %5 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %4, i32 0, i32 2
 store double 0.5, double* %5
 %6 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_7
 %7 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %6, i32 0, i32 3
 store double 0.5, double* %7
 %8 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_7
 %9 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %8, i32 0, i32 4
 store double 0.5, double* %9
 %10 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_7
 ret %form.EmotionPolicy* %10
}

define i32 @decide(%form.EmotionPolicy* %arg0, i32 %arg1, double %arg2) {
entry:
 %policy_ptr = alloca %form.EmotionPolicy*
 %emotion_state_ptr = alloca i32
 %evidence_ptr = alloca double
 %threshold_ptr_8 = alloca double
 %decision_ptr_19 = alloca i32
 store %form.EmotionPolicy* %arg0, %form.EmotionPolicy** %policy_ptr
 store i32 %arg1, i32* %emotion_state_ptr
 store double %arg2, double* %evidence_ptr
 store double 0.5, double* %threshold_ptr_8
 %1 = load i32, i32* %emotion_state_ptr
 br label %route_cmp_13

route_cmp_13:
 %2 = icmp eq i32 %1, 0
 br i1 %2, label %route_path_9, label %route_cmp_14

route_cmp_14:
 %3 = icmp eq i32 %1, 1
 br i1 %3, label %route_path_10, label %route_cmp_15

route_cmp_15:
 %4 = icmp eq i32 %1, 2
 br i1 %4, label %route_path_11, label %route_cmp_16

route_cmp_16:
 %5 = icmp eq i32 %1, 3
 br i1 %5, label %route_path_12, label %route_after_18

route_path_9:
 %6 = load %form.EmotionPolicy*, %form.EmotionPolicy** %policy_ptr
 %7 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %6, i32 0, i32 1
 %8 = load double, double* %7
 store double %8, double* %threshold_ptr_8
 br label %route_after_18

route_path_10:
 %9 = load %form.EmotionPolicy*, %form.EmotionPolicy** %policy_ptr
 %10 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %9, i32 0, i32 2
 %11 = load double, double* %10
 store double %11, double* %threshold_ptr_8
 br label %route_after_18

route_path_11:
 %12 = load %form.EmotionPolicy*, %form.EmotionPolicy** %policy_ptr
 %13 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %12, i32 0, i32 3
 %14 = load double, double* %13
 store double %14, double* %threshold_ptr_8
 br label %route_after_18

route_path_12:
 %15 = load %form.EmotionPolicy*, %form.EmotionPolicy** %policy_ptr
 %16 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %15, i32 0, i32 4
 %17 = load double, double* %16
 store double %17, double* %threshold_ptr_8
 br label %route_after_18

route_after_18:
 store i32 0, i32* %decision_ptr_19
 %18 = load double, double* %evidence_ptr
 %19 = load double, double* %threshold_ptr_8
 %20 = fcmp ogt double %18, %19
 br i1 %20, label %if_then_20, label %if_after_22

if_then_20:
 store i32 1, i32* %decision_ptr_19
 br label %if_after_22

if_after_22:
 %21 = load i32, i32* %decision_ptr_19
 ret i32 %21
}

define %QObject* @dream_state(double %arg0) {
entry:
 %dt_ptr = alloca double
 %world_ptr_23 = alloca %QObject*
 store double %arg0, double* %dt_ptr
 %1 = call %QObject* @qk_create_QuantumRegister(i32 2)
 store %QObject* %1, %QObject** %world_ptr_23
 %2 = load %QObject*, %QObject** %world_ptr_23
 call void @qk_qgate_h(%QObject* %2, i32 0)
 %3 = load %QObject*, %QObject** %world_ptr_23
 %4 = load double, double* %dt_ptr
 %5 = fmul double %4, 3.14159265358979
 call void @qk_qgate_rz(%QObject* %3, i32 0, double %5)
 %6 = load %QObject*, %QObject** %world_ptr_23
 call void @qk_qgate_h(%QObject* %6, i32 0)
 %7 = load %QObject*, %QObject** %world_ptr_23
 %8 = load double, double* %dt_ptr
 %9 = call %QObject* @chaos_drift(%QObject* %7, double %8)
 store %QObject* %9, %QObject** %world_ptr_23
 %10 = load %QObject*, %QObject** %world_ptr_23
 ret %QObject* %10
}

define double @quality_of(%QObject* %arg0) {
entry:
 %state_ptr = alloca %QObject*
 store %QObject* %arg0, %QObject** %state_ptr
 %1 = load %QObject*, %QObject** %state_ptr
 %2 = call double @qk_qexpect_z(%QObject* %1, i32 0)
 %3 = load %QObject*, %QObject** %state_ptr
 call void @qk_release_object(%QObject* %3)
 ret double %2
}

