// ═══════════════════════════════════════════════════════════════════════════════
// chimera_drive.qk —— Chimera 量子智能驾驶超级大模型（全激活 / 万级深度版）
// ═══════════════════════════════════════════════════════════════════════════════
//
// 与前一版的关键区别：**去掉 MoE 稀疏门控（route 选 1），改为全激活**。
// 即：256 个组件在每一帧里全部激活执行，无一被稀疏跳过。
//
// 落地三条扩展路径：
//   1. 深到 100+ 层   —— 4 条分支 × 每分支 29 集群 × 4 周期 = 运行时 116 层深堆叠
//   2. 每层全量展开   —— 每个范式集群的全部组件（~8 个）在每层里显式调用，不再 route 选 1
//   3. 多分支并行     —— 意识态拆成 4 条独立量子分支，各走 7~8 个范式集群，最后融合
//
// 架构：
//   ┌──────────────────────────────────────────────────────────────┐
//   │ ① 64 维参数空间 p00..p63（跨 MMI_INVOKE 持久，构成模型权重）   │
//   ├──────────────────────────────────────────────────────────────┤
//   │ ② 输入编码 + 25 现有组件主线（感知/意识/情绪/决策/元认知/逆因果）│
//   ├──────────────────────────────────────────────────────────────┤
//   │ ③ 多分支展开：b0(耗散/MIPT/因果/几何/拓扑/QRC/QEC/意识)        │
//   │              b1(语言/优化/路由/生成/鲁棒/多体/图)              │
//   │              b2(时序/信号/核/集成/元/连续/XAI)                │
//   │              b3(神经符号/QAOA/动力/信息论/压缩/聚类/RL)        │
//   │    每分支 4 周期深度堆叠，每周期全量调用其负责集群的全部组件    │
//   ├──────────────────────────────────────────────────────────────┤
//   │ ④ 融合：4 分支信号 + 分支态重叠 → steer                        │
//   └──────────────────────────────────────────────────────────────┘
//
// 输入：drive(lateral, evidence, reward) -> steer
// 运行：Quark runtime QVM 后端；经 `qk mmi` 打包为 .mmi 供 autopilot.py 调用。

requires quantum.allocate;
requires quantum.gate;
requires quantum.measure;
requires quantum.release;

// ── 态射宏库（morph 元编程：硬编码数值 → 语义态射，需最先 include）──
include "../src/chimera_morphs.qk";

// ── 现有 25 组件 ──
include "../src/chimera_perception.qk";
