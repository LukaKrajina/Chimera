define double @test_cnot() {
entry:
 %q_ptr_1 = alloca %QObject*
 %s_ptr_2 = alloca i32
 %e_ptr_6 = alloca double
 %_a_ptr_7 = alloca i32
 %_b_ptr_8 = alloca i32
 %1 = call %QObject* @qk_create_QuantumRegister(i32 2)
 store %QObject* %1, %QObject** %q_ptr_1
 store i32 0, i32* %s_ptr_2
 br label %while_cond_3

while_cond_3:
 %2 = load i32, i32* %s_ptr_2
 %3 = icmp slt i32 %2, 8
 br i1 %3, label %while_body_4, label %while_after_5

while_body_4:
 %4 = load %QObject*, %QObject** %q_ptr_1
 call void @qk_qgate_cnot(%QObject* %4, i32 0, i32 1)
 %5 = load %QObject*, %QObject** %q_ptr_1
 %6 = call double @qk_qexpect_z(%QObject* %5, i32 1)
 store double %6, double* %e_ptr_6
 %7 = load %QObject*, %QObject** %q_ptr_1
 call void @qk_qgate_cnot(%QObject* %7, i32 0, i32 1)
 %8 = load i32, i32* %s_ptr_2
 %9 = add i32 %8, 1
 store i32 %9, i32* %s_ptr_2
 br label %while_cond_3

while_after_5:
 %10 = load %QObject*, %QObject** %q_ptr_1
 %11 = call i32 @qk_qmeasure(%QObject* %10, i32 0)
 store i32 %11, i32* %_a_ptr_7
 %12 = load %QObject*, %QObject** %q_ptr_1
 %13 = call i32 @qk_qmeasure(%QObject* %12, i32 1)
 store i32 %13, i32* %_b_ptr_8
 %14 = load %QObject*, %QObject** %q_ptr_1
 call void @qk_release_object(%QObject* %14)
 ret double 1.0
}