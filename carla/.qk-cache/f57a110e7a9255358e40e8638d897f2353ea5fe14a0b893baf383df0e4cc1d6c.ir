; --- 并发线程（spawn）ABI ---
declare void @qk_spawn(i8*, i8*)


define double @drive(double %arg0, double %arg1, double %arg2) {
entry:
 %lateral_ptr = alloca double
 %evidence_ptr = alloca double
 %reward_ptr = alloca double
 %steer_ptr_1 = alloca double
 store double %arg0, double* %lateral_ptr
 store double %arg1, double* %evidence_ptr
 store double %arg2, double* %reward_ptr
 %1 = fsub double -0.0, 1.0
 %2 = load double, double* %lateral_ptr
 %3 = fmul double %1, %2
 store double %3, double* %steer_ptr_1
 %4 = load double, double* %steer_ptr_1
 %5 = fcmp ogt double %4, 1.0
 br i1 %5, label %if_then_2, label %if_after_4

if_then_2:
 store double 1.0, double* %steer_ptr_1
 br label %if_after_4

if_after_4:
 %6 = load double, double* %steer_ptr_1
 %7 = fsub double -0.0, 1.0
 %8 = fcmp olt double %6, %7
 br i1 %8, label %if_then_5, label %if_after_7

if_then_5:
 %9 = fsub double -0.0, 1.0
 store double %9, double* %steer_ptr_1
 br label %if_after_7

if_after_7:
 %10 = load double, double* %steer_ptr_1
 ret double %10
}