@qk_topology_json = private unnamed_addr constant [150 x i8] c"{\22shape\22:{\22time\22:1,\22thread\22:1,\22coord\22:[3]},\22blocks\22:[{\22name\22:\22init_policy\22,\22time\22:0,\22thread\22:0,\22coord\22:[2],\22cost\22:1,\22deadline\22:null}],\22callGraph\22:[]}\00", align 1

define i32 @qk_topology_entry() {
entry:
