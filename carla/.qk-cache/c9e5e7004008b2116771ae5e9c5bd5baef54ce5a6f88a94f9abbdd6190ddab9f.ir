define %QObject* @mipt_drive(%QObject* %arg0, double %arg1, i32 %arg2, i32 %arg3) {
entry:
 %state_ptr = alloca %QObject*
 %dt_ptr = alloca double
 %steps_ptr = alloca i32
 %measure_every_ptr = alloca i32
 %k_ptr_1 = alloca i32
 %cnt_ptr_2 = alloca i32
 %n_ptr_6 = alloca i32
 %i_ptr_7 = alloca i32
 %j_ptr_11 = alloca i32
 %__ptr_21 = alloca i32
 store %QObject* %arg0, %QObject** %state_ptr
 store double %arg1, double* %dt_ptr
 store i32 %arg2, i32* %steps_ptr
 store i32 %arg3, i32* %measure_every_ptr
 store i32 0, i32* %k_ptr_1
 store i32 0, i32* %cnt_ptr_2
 br label %while_cond_3

while_cond_3:
 %1 = load i32, i32* %k_ptr_1
 %2 = load i32, i32* %steps_ptr
 %3 = icmp slt i32 %1, %2
 br i1 %3, label %while_body_4, label %while_after_5

while_body_4:
 %4 = load %QObject*, %QObject** %state_ptr
 %5 = call i32 @qk_qobj_num_qubits(%QObject* %4)
 store i32 %5, i32* %n_ptr_6
 store i32 0, i32* %i_ptr_7
 br label %while_cond_8

while_cond_8:
 %6 = load i32, i32* %i_ptr_7
 %7 = load i32, i32* %n_ptr_6
 %8 = icmp slt i32 %6, %7
 br i1 %8, label %while_body_9, label %while_after_10

while_body_9:
 %9 = load %QObject*, %QObject** %state_ptr
 %10 = load i32, i32* %i_ptr_7
 call void @qk_qgate_h(%QObject* %9, i32 %10)
 %11 = load %QObject*, %QObject** %state_ptr
 %12 = load i32, i32* %i_ptr_7
 %13 = load double, double* %dt_ptr
 %14 = load i32, i32* %i_ptr_7
 %15 = sitofp i32 %14 to double
 %16 = fmul double 0.1, %15
 %17 = fadd double 1.61803398874989, %16
 %18 = fmul double %13, %17
 call void @qk_qgate_rz(%QObject* %11, i32 %12, double %18)
 %19 = load i32, i32* %i_ptr_7
 %20 = add i32 %19, 1
 store i32 %20, i32* %i_ptr_7
 br label %while_cond_8

while_after_10:
 store i32 0, i32* %j_ptr_11
 br label %while_cond_12

while_cond_12:
 %21 = load i32, i32* %j_ptr_11
 %22 = load i32, i32* %n_ptr_6
 %23 = sub i32 %22, 1
 %24 = icmp slt i32 %21, %23
 br i1 %24, label %while_body_13, label %while_after_14

while_body_13:
 %25 = load %QObject*, %QObject** %state_ptr
 %26 = load i32, i32* %j_ptr_11
 %27 = load i32, i32* %j_ptr_11
 %28 = add i32 %27, 1
 call void @qk_qgate_cnot(%QObject* %25, i32 %26, i32 %28)
 %29 = load i32, i32* %j_ptr_11
 %30 = add i32 %29, 1
 store i32 %30, i32* %j_ptr_11
 br label %while_cond_12

while_after_14:
 %31 = load i32, i32* %measure_every_ptr
 %32 = icmp sgt i32 %31, 0
 br i1 %32, label %if_then_15, label %if_after_17

if_then_15:
 %33 = load i32, i32* %cnt_ptr_2
 %34 = load i32, i32* %measure_every_ptr
 %35 = icmp sge i32 %33, %34
 br i1 %35, label %if_then_18, label %if_after_20

if_then_18:
 %36 = load %QObject*, %QObject** %state_ptr
 %37 = call i32 @qk_qmeasure(%QObject* %36, i32 0)
 store i32 %37, i32* %__ptr_21
 store i32 0, i32* %cnt_ptr_2
 br label %if_after_20

if_after_20:
 %38 = load i32, i32* %cnt_ptr_2
 %39 = add i32 %38, 1
 store i32 %39, i32* %cnt_ptr_2
 br label %if_after_17

if_after_17:
 %40 = load i32, i32* %k_ptr_1
 %41 = add i32 %40, 1
 store i32 %41, i32* %k_ptr_1
 br label %while_cond_3

while_after_5:
 %42 = load %QObject*, %QObject** %state_ptr
 ret %QObject* %42
}

define double @measurement_entropy_flow(double %arg0, i32 %arg1, double %arg2) {
entry:
 %dt_ptr = alloca double
 %steps_ptr = alloca i32
 %s_prev_ptr = alloca double
 %s_now_ptr_22 = alloca double
 %flow_ptr_23 = alloca double
 store double %arg0, double* %dt_ptr
 store i32 %arg1, i32* %steps_ptr
 store double %arg2, double* %s_prev_ptr
 %1 = load double, double* %dt_ptr
 %2 = load i32, i32* %steps_ptr
 %3 = call double @sample_entropy(double %1, i32 %2)
 store double %3, double* %s_now_ptr_22
 %4 = load double, double* %s_now_ptr_22
 %5 = load double, double* %s_prev_ptr
 %6 = fsub double %4, %5
 store double %6, double* %flow_ptr_23
 %7 = load double, double* %flow_ptr_23
 %8 = fcmp olt double %7, 0.0
 br i1 %8, label %if_then_24, label %if_after_26

if_then_24:
 %9 = load double, double* %flow_ptr_23
 %10 = fsub double -0.0, %9
 store double %10, double* %flow_ptr_23
 br label %if_after_26

if_after_26:
 %11 = load double, double* %flow_ptr_23
 ret double %11
}

define double @entanglement_transition_probe(%QObject* %arg0) {
entry:
 %state_ptr = alloca %QObject*
 %n_ptr_27 = alloca i32
 %z_ptr_31 = alloca double
 %cut_ptr_35 = alloca i32
 %acc_ptr_39 = alloca double
 %s_ptr_40 = alloca i32
 store %QObject* %arg0, %QObject** %state_ptr
 %1 = load %QObject*, %QObject** %state_ptr
 %2 = call i32 @qk_qobj_num_qubits(%QObject* %1)
 store i32 %2, i32* %n_ptr_27
 %3 = load i32, i32* %n_ptr_27
 %4 = icmp slt i32 %3, 2
 br i1 %4, label %if_then_28, label %if_after_30

if_then_28:
 %5 = load %QObject*, %QObject** %state_ptr
 %6 = call double @qk_qexpect_z(%QObject* %5, i32 0)
 store double %6, double* %z_ptr_31
 %7 = load double, double* %z_ptr_31
 %8 = fcmp olt double %7, 0.0
 br i1 %8, label %if_then_32, label %if_after_34

if_then_32:
 %9 = load double, double* %z_ptr_31
 %10 = fsub double -0.0, %9
 store double %10, double* %z_ptr_31
 br label %if_after_34

if_after_34:
 %11 = load double, double* %z_ptr_31
 %12 = load %QObject*, %QObject** %state_ptr
 call void @qk_release_object(%QObject* %12)
 ret double %11

if_after_30:
 %13 = load i32, i32* %n_ptr_27
 %14 = sdiv i32 %13, 2
 store i32 %14, i32* %cut_ptr_35
 %15 = load i32, i32* %cut_ptr_35
 %16 = load i32, i32* %n_ptr_27
 %17 = icmp sge i32 %15, %16
 br i1 %17, label %if_then_36, label %if_after_38

if_then_36:
 %18 = load i32, i32* %n_ptr_27
 %19 = sub i32 %18, 1
 store i32 %19, i32* %cut_ptr_35
 br label %if_after_38

if_after_38:
 store double 0.0, double* %acc_ptr_39
 store i32 0, i32* %s_ptr_40
 br label %while_cond_41

while_cond_41:
 %20 = load i32, i32* %s_ptr_40
 %21 = icmp slt i32 %20, 8
 br i1 %21, label %while_body_42, label %while_after_43

while_body_42:
 %22 = load %QObject*, %QObject** %state_ptr
 %23 = load i32, i32* %cut_ptr_35
 %24 = sub i32 %23, 1
 %25 = load i32, i32* %cut_ptr_35
 call void @qk_qgate_cnot(%QObject* %22, i32 %24, i32 %25)
 %26 = load double, double* %acc_ptr_39
 %27 = load %QObject*, %QObject** %state_ptr
 %28 = load i32, i32* %cut_ptr_35
 %29 = call double @qk_qexpect_z(%QObject* %27, i32 %28)
 %30 = fadd double %26, %29
 store double %30, double* %acc_ptr_39
 %31 = load %QObject*, %QObject** %state_ptr
 %32 = load i32, i32* %cut_ptr_35
 %33 = sub i32 %32, 1
 %34 = load i32, i32* %cut_ptr_35
 call void @qk_qgate_cnot(%QObject* %31, i32 %33, i32 %34)
 %35 = load i32, i32* %s_ptr_40
 %36 = add i32 %35, 1
 store i32 %36, i32* %s_ptr_40
 br label %while_cond_41

while_after_43:
 %37 = load double, double* %acc_ptr_39
 %38 = fdiv double %37, 8.0
 store double %38, double* %acc_ptr_39
 %39 = load double, double* %acc_ptr_39
 %40 = fcmp olt double %39, 0.0
 br i1 %40, label %if_then_44, label %if_after_46

if_then_44:
 %41 = load double, double* %acc_ptr_39
 %42 = fsub double -0.0, %41
 store double %42, double* %acc_ptr_39
 br label %if_after_46

if_after_46:
 %43 = load double, double* %acc_ptr_39
 %44 = load %QObject*, %QObject** %state_ptr
 call void @qk_release_object(%QObject* %44)
 ret double %43
}

define double @monitor_rate_scheduler(double %arg0, double %arg1, double %arg2) {
entry:
 %rate_ptr = alloca double
 %entropy_ptr = alloca double
 %target_ptr = alloca double
 %grad_ptr_47 = alloca double
 %new_rate_ptr_48 = alloca double
 store double %arg0, double* %rate_ptr
 store double %arg1, double* %entropy_ptr
 store double %arg2, double* %target_ptr
 %1 = load double, double* %entropy_ptr
 %2 = load double, double* %target_ptr
 %3 = fsub double %1, %2
 %4 = call double @qk_surrogate(double %3, double 0.0, double 1.0)
 store double %4, double* %grad_ptr_47
 %5 = load double, double* %rate_ptr
 %6 = load double, double* %grad_ptr_47
 %7 = fmul double 0.05, %6
 %8 = fsub double %5, %7
 store double %8, double* %new_rate_ptr_48
 %9 = load double, double* %new_rate_ptr_48
 %10 = fcmp olt double %9, 0.0
 br i1 %10, label %if_then_49, label %if_after_51

if_then_49:
 store double 0.0, double* %new_rate_ptr_48
 br label %if_after_51

if_after_51:
 %11 = load double, double* %new_rate_ptr_48
 %12 = fcmp ogt double %11, 1.0
 br i1 %12, label %if_then_52, label %if_after_54

if_then_52:
 store double 1.0, double* %new_rate_ptr_48
 br label %if_after_54

if_after_54:
 %13 = load double, double* %new_rate_ptr_48
 ret double %13
}

define double @area_law_estimator(%QObject* %arg0, double %arg1, double %arg2) {
entry:
 %state_ptr = alloca %QObject*
 %boundary_size_ptr = alloca double
 %volume_size_ptr = alloca double
 %s_ptr_55 = alloca double
 %shots_ptr_56 = alloca i32
 %sh_ptr_57 = alloca i32
 %e_ptr_61 = alloca double
 %area_ratio_ptr_65 = alloca double
 %vol_ratio_ptr_66 = alloca double
 store %QObject* %arg0, %QObject** %state_ptr
 store double %arg1, double* %boundary_size_ptr
 store double %arg2, double* %volume_size_ptr
 store double 0.0, double* %s_ptr_55
 store i32 8, i32* %shots_ptr_56
 store i32 0, i32* %sh_ptr_57
 br label %while_cond_58

while_cond_58:
 %1 = load i32, i32* %sh_ptr_57
 %2 = load i32, i32* %shots_ptr_56
 %3 = icmp slt i32 %1, %2
