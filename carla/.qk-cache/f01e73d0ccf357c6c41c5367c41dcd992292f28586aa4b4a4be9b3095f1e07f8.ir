; ModuleID = 'quark_module'
source_filename = "quark_script.qk"

; --- QIR Standard Library ---
%Qubit = type opaque
%QObject = type opaque
%QModel = type opaque
%QReservoir = type opaque
; --- 晶格数组类型（lattice<T, B>，吸收 Futhark/Remora/Rust）---
%Lattice = type opaque

%form.EmotionReading = type { i8*, i32, %QObject* }
%form.WeakReading = type { i8*, i32, %QObject* }
%form.EmotionPolicy = type { i8*, double, double, double, double }
%form.ErrorReading = type { i8*, double, double, i32 }
%form.ConceptPair = type { i8*, %QObject*, %QObject* }

@.str.1 = private unnamed_addr constant [4 x i8] c"X,Z\00", align 1
@.str.2 = private unnamed_addr constant [5 x i8] c"road\00", align 1
@.str.3 = private unnamed_addr constant [11 x i8] c"steer lane\00", align 1
@.str.4 = private unnamed_addr constant [6 x i8] c"drive\00", align 1
@.str.5 = private unnamed_addr constant [5 x i8] c"lane\00", align 1
@.str.6 = private unnamed_addr constant [6 x i8] c"curve\00", align 1

@g_thr0 = global double 0.5, align 8
@g_thr1 = global double 0.5, align 8
@g_thr2 = global double 0.5, align 8
@g_thr3 = global double 0.5, align 8
@g_dt = global double 0.6, align 8
@g_theta = global double 0.5, align 8
@g_memory = global double 0.5, align 8
@g_emotion_history = global double 1.5, align 8
@g_inhibit = global double 0.6, align 8

