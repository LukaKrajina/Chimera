define %QObject* @dissipative_gate(%QObject* %arg0, double %arg1, i32 %arg2) {
entry:
 %state_ptr = alloca %QObject*
 %rate_ptr = alloca double
 %model_ptr = alloca i32
 %gap_ptr_1 = alloca double
 %eps_ptr_5 = alloca double
 %anc_ptr_6 = alloca %QObject*
 %__ptr_7 = alloca i32
 store %QObject* %arg0, %QObject** %state_ptr
 store double %arg1, double* %rate_ptr
 store i32 %arg2, i32* %model_ptr
 %1 = load i32, i32* %model_ptr
 %2 = load double, double* %rate_ptr
 %3 = load double, double* %rate_ptr
 %4 = call double @qk_qms_gap(i32 %1, double %2, double %3)
 store double %4, double* %gap_ptr_1
 %5 = load double, double* %gap_ptr_1
 %6 = fcmp olt double %5, 0.0
 br i1 %6, label %if_then_2, label %if_after_4

if_then_2:
 store double 0.0, double* %gap_ptr_1
 br label %if_after_4

if_after_4:
 %7 = load double, double* %gap_ptr_1
 %8 = fsub double 1.0, %7
 %9 = fmul double 0.5, %8
 %10 = fadd double 0.05, %9
 store double %10, double* %eps_ptr_5
 %11 = call %QObject* @qk_create_QuantumRegister(i32 1)
 store %QObject* %11, %QObject** %anc_ptr_6
 %12 = load %QObject*, %QObject** %anc_ptr_6
 call void @qk_qgate_h(%QObject* %12, i32 0)
 %13 = load %QObject*, %QObject** %state_ptr
 %14 = load %QObject*, %QObject** %anc_ptr_6
 call void @qk_qgate_cnot_pair(%QObject* %13, i32 0, %QObject* %14, i32 0)
 %15 = load %QObject*, %QObject** %anc_ptr_6
 %16 = load double, double* %eps_ptr_5
 call void @qk_qgate_rz(%QObject* %15, i32 0, double %16)
 %17 = load %QObject*, %QObject** %state_ptr
 %18 = load %QObject*, %QObject** %anc_ptr_6
 call void @qk_qgate_cnot_pair(%QObject* %17, i32 0, %QObject* %18, i32 0)
 %19 = load %QObject*, %QObject** %anc_ptr_6
 call void @qk_qgate_h(%QObject* %19, i32 0)
 %20 = load %QObject*, %QObject** %anc_ptr_6
 %21 = call i32 @qk_measure_object(%QObject* %20)
 store i32 %21, i32* %__ptr_7
 %22 = load %QObject*, %QObject** %state_ptr
 %23 = load %QObject*, %QObject** %anc_ptr_6
 call void @qk_release_object(%QObject* %23)
 ret %QObject* %22
}

define %QObject* @amplitude_damping_layer(%QObject* %arg0, double %arg1) {
entry:
 %state_ptr = alloca %QObject*
 %gamma_ptr = alloca double
 %gap_ptr_8 = alloca double
 %relax_ptr_12 = alloca double
 %n_ptr_13 = alloca i32
 %i_ptr_14 = alloca i32
 %anc_ptr_18 = alloca %QObject*
 %__ptr_19 = alloca i32
 store %QObject* %arg0, %QObject** %state_ptr
 store double %arg1, double* %gamma_ptr
 %1 = load double, double* %gamma_ptr
 %2 = load double, double* %gamma_ptr
 %3 = call double @qk_qms_gap(i32 2, double %1, double %2)
 store double %3, double* %gap_ptr_8
 %4 = load double, double* %gap_ptr_8
 %5 = fcmp olt double %4, 0.0
 br i1 %5, label %if_then_9, label %if_after_11

if_then_9:
 store double 0.0, double* %gap_ptr_8
 br label %if_after_11

if_after_11:
 %6 = load double, double* %gamma_ptr
 %7 = load double, double* %gap_ptr_8
 %8 = fsub double 1.0, %7
 %9 = fmul double %6, %8
 store double %9, double* %relax_ptr_12
 %10 = load %QObject*, %QObject** %state_ptr
 %11 = call i32 @qk_qobj_num_qubits(%QObject* %10)
 store i32 %11, i32* %n_ptr_13
 store i32 0, i32* %i_ptr_14
 br label %while_cond_15

while_cond_15:
 %12 = load i32, i32* %i_ptr_14
 %13 = load i32, i32* %n_ptr_13
 %14 = icmp slt i32 %12, %13
 br i1 %14, label %while_body_16, label %while_after_17

while_body_16:
 %15 = call %QObject* @qk_create_QuantumRegister(i32 1)
 store %QObject* %15, %QObject** %anc_ptr_18
 %16 = load %QObject*, %QObject** %state_ptr
 %17 = load i32, i32* %i_ptr_14
 %18 = load %QObject*, %QObject** %anc_ptr_18
 call void @qk_qgate_cnot_pair(%QObject* %16, i32 %17, %QObject* %18, i32 0)
 %19 = load %QObject*, %QObject** %anc_ptr_18
 %20 = load double, double* %relax_ptr_12
 call void @qk_qgate_rz(%QObject* %19, i32 0, double %20)
 %21 = load %QObject*, %QObject** %state_ptr
 %22 = load i32, i32* %i_ptr_14
 %23 = load %QObject*, %QObject** %anc_ptr_18
 call void @qk_qgate_cnot_pair(%QObject* %21, i32 %22, %QObject* %23, i32 0)
 %24 = load %QObject*, %QObject** %anc_ptr_18
 %25 = call i32 @qk_measure_object(%QObject* %24)
 store i32 %25, i32* %__ptr_19
 %26 = load i32, i32* %i_ptr_14
 %27 = add i32 %26, 1
 store i32 %27, i32* %i_ptr_14
 %28 = load %QObject*, %QObject** %anc_ptr_18
 call void @qk_release_object(%QObject* %28)
 br label %while_cond_15

while_after_17:
 %29 = load %QObject*, %QObject** %state_ptr
 ret %QObject* %29
}

define double @dephasing_attention(double %arg0, double %arg1) {
entry:
 %score_ptr = alloca double
 %dephase_ptr = alloca double
 %gap_ptr_20 = alloca double
 %temp_ptr_24 = alloca double
 %signal_ptr_25 = alloca %QObject*
 %anc_ptr_26 = alloca %QObject*
 %_a_ptr_27 = alloca i32
 %z_ptr_28 = alloca double
 %s_ptr_29 = alloca i32
 %_c_ptr_33 = alloca i32
 store double %arg0, double* %score_ptr
 store double %arg1, double* %dephase_ptr
 %1 = load double, double* %dephase_ptr
 %2 = load double, double* %dephase_ptr
 %3 = call double @qk_qms_gap(i32 1, double %1, double %2)
 store double %3, double* %gap_ptr_20
 %4 = load double, double* %gap_ptr_20
 %5 = fcmp olt double %4, 0.0
 br i1 %5, label %if_then_21, label %if_after_23

if_then_21:
 store double 0.0, double* %gap_ptr_20
 br label %if_after_23

if_after_23:
 %6 = load double, double* %gap_ptr_20
 %7 = fadd double 0.05, %6
 store double %7, double* %temp_ptr_24
 %8 = load double, double* %score_ptr
 %9 = fmul double %8, 3.14159265358979
 %10 = call %QObject* @qk_create_basis_state(double %9, double 0.0, i32 0)
 store %QObject* %10, %QObject** %signal_ptr_25
 %11 = call %QObject* @qk_create_QuantumRegister(i32 1)
 store %QObject* %11, %QObject** %anc_ptr_26
 %12 = load %QObject*, %QObject** %anc_ptr_26
 call void @qk_qgate_h(%QObject* %12, i32 0)
 %13 = load %QObject*, %QObject** %signal_ptr_25
 %14 = load %QObject*, %QObject** %anc_ptr_26
 call void @qk_qgate_cnot_pair(%QObject* %13, i32 0, %QObject* %14, i32 0)
 %15 = load %QObject*, %QObject** %anc_ptr_26
 %16 = load double, double* %dephase_ptr
 call void @qk_qgate_rz(%QObject* %15, i32 0, double %16)
 %17 = load %QObject*, %QObject** %signal_ptr_25
 %18 = load %QObject*, %QObject** %anc_ptr_26
 call void @qk_qgate_cnot_pair(%QObject* %17, i32 0, %QObject* %18, i32 0)
 %19 = load %QObject*, %QObject** %anc_ptr_26
 call void @qk_qgate_h(%QObject* %19, i32 0)
 %20 = load %QObject*, %QObject** %anc_ptr_26
 %21 = call i32 @qk_measure_object(%QObject* %20)
 store i32 %21, i32* %_a_ptr_27
 store double 0.0, double* %z_ptr_28
 store i32 0, i32* %s_ptr_29
 br label %while_cond_30

while_cond_30:
 %22 = load i32, i32* %s_ptr_29
 %23 = icmp slt i32 %22, 8
 br i1 %23, label %while_body_31, label %while_after_32

while_body_31:
 %24 = load double, double* %z_ptr_28
 %25 = load %QObject*, %QObject** %signal_ptr_25
 %26 = call double @qk_qexpect_z(%QObject* %25, i32 0)
 %27 = fadd double %24, %26
 store double %27, double* %z_ptr_28
 %28 = load i32, i32* %s_ptr_29
 %29 = add i32 %28, 1
 store i32 %29, i32* %s_ptr_29
 br label %while_cond_30

while_after_32:
 %30 = load %QObject*, %QObject** %signal_ptr_25
 %31 = call i32 @qk_measure_object(%QObject* %30)
 store i32 %31, i32* %_c_ptr_33
 %32 = load double, double* %z_ptr_28
 %33 = fdiv double %32, 8.0
 store double %33, double* %z_ptr_28
 %34 = load double, double* %z_ptr_28
 %35 = load double, double* %temp_ptr_24
 %36 = fdiv double 1.0, %35
 %37 = call double @qk_boltzmann2(double %34, double 0.0, double %36)
 %38 = load %QObject*, %QObject** %signal_ptr_25
 call void @qk_release_object(%QObject* %38)
 %39 = load %QObject*, %QObject** %anc_ptr_26
 call void @qk_release_object(%QObject* %39)
 ret double %37
}

define %QObject* @depolarizing_dropout(%QObject* %arg0, double %arg1) {
entry:
 %state_ptr = alloca %QObject*
 %p_ptr = alloca double
 %keep_ptr_34 = alloca double
 %n_ptr_38 = alloca i32
 %i_ptr_39 = alloca i32
 %__ptr_46 = alloca i32
 store %QObject* %arg0, %QObject** %state_ptr
 store double %arg1, double* %p_ptr
 %1 = load double, double* %p_ptr
 %2 = fsub double 1.0, %1
 store double %2, double* %keep_ptr_34
 %3 = load double, double* %keep_ptr_34
 %4 = fcmp olt double %3, 0.0
 br i1 %4, label %if_then_35, label %if_after_37

if_then_35:
 store double 0.0, double* %keep_ptr_34
 br label %if_after_37

if_after_37:
 %5 = load %QObject*, %QObject** %state_ptr
 %6 = call i32 @qk_qobj_num_qubits(%QObject* %5)
 store i32 %6, i32* %n_ptr_38
 store i32 0, i32* %i_ptr_39
 br label %while_cond_40

while_cond_40:
 %7 = load i32, i32* %i_ptr_39
 %8 = load i32, i32* %n_ptr_38
 %9 = icmp slt i32 %7, %8
 br i1 %9, label %while_body_41, label %while_after_42

while_body_41:
 %10 = load %QObject*, %QObject** %state_ptr
 %11 = load i32, i32* %i_ptr_39
 %12 = load double, double* %keep_ptr_34
 %13 = fmul double %12, 0.1
 %14 = load i32, i32* %i_ptr_39
 %15 = sitofp i32 %14 to double
 %16 = fmul double 0.05, %15
 %17 = fadd double 1.0, %16
 %18 = fmul double %13, %17
 call void @qk_qgate_rz(%QObject* %10, i32 %11, double %18)
 %19 = load i32, i32* %i_ptr_39
 %20 = add i32 %19, 1
 store i32 %20, i32* %i_ptr_39
 br label %while_cond_40

while_after_42:
 %21 = load double, double* %p_ptr
 %22 = fcmp ogt double %21, 0.5
 br i1 %22, label %if_then_43, label %if_after_45

if_then_43:
 %23 = load %QObject*, %QObject** %state_ptr
 %24 = call i32 @qk_qmeasure(%QObject* %23, i32 0)
 store i32 %24, i32* %__ptr_46
