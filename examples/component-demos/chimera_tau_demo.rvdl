// chimera_tau_demo.rvdl —— 时间缩微（τ）集群自包含演示
//
// 验证 τ 缩微六原语的数值行为（不需要量子寄存器，纯标量数学，自包含）：
//   ① 分层复合截止期（四层求和）
//   ② 领域缩放因子 α（移动 1.3 / 自驾 1.5 / AI 10）
//   ③ 代际法则 τ_{n+1} = τ_n/α（自驾域连缩 3 代）
//   ④ 折叠深度 ⌈L/T⌉（12 层串行深度折进 4 个并行 tier → 3）
//   ⑤ 齿轮比与调度代价（g = 6/10 = 0.6；代价 = 3·1 + 3·0.6·0.5 = 3.9）
//   ⑥ 时间影子价格门控（λ 上升 → 净价值转负 → 路由关闭）
//
// 运行前需启动守护进程：./runtime --daemon
// 全部通过返回 0；任一数值不符返回对应序号（1..6）。

include "../../src/chimera_tau.rvdl";

@layer(time=0, thread=0, coord=(0))
int32 rvdl_main() {
    int32 fail = 0;

    // ① 分层复合：1.0 + 2.0 + 3.0 + 4.0 = 10.0
    double dl = tau_deadline(1.0, 2.0, 3.0, 4.0);
    if (dl < 9.999 || dl > 10.001) { fail = 1; }

    // ② 领域缩放因子
    double a_mob  = tau_domain_alpha(0.0);
    double a_auto = tau_domain_alpha(1.0);
    double a_ai   = tau_domain_alpha(2.0);
    if (a_mob < 1.29 || a_mob > 1.31)  { fail = 2; }
    if (a_auto < 1.49 || a_auto > 1.51) { fail = 2; }
    if (a_ai < 9.9 || a_ai > 10.1)     { fail = 2; }

    // ③ 代际缩放：自驾域（α=1.5）连缩 3 代：10 → 6.666… → 4.444… → 2.96296…
    double b3 = tau_anneal_budget(10.0, 1.0, 3);
    if (b3 < 2.962 || b3 > 2.964) { fail = 3; }

    // ④/⑤ 折叠计划：12 层 → 4 tier，跨层边 6、层内边 10，门 1.0、通信 0.5
    //   D = ceil(12/4) = 3；g = 0.6；cost = 3·1 + 3·0.6·0.5 = 3.9
    double plan = tau_fold_plan(12.0, 4.0, 6.0, 10.0, 1.0, 0.5);
    if (plan < 3.899 || plan > 3.901) { fail = 4; }

    // ⑤补：齿轮比阈值 3——跨层通信独占（层内边 0）时折叠不划算的判据成立
    double g_bad = tau_gear_ratio(1.0, 0.0);
    if (g_bad < 3.0) { fail = 5; }

    // ⑥ 影子价格门控：价值 5、成本 2；λ=1 → 净 +3（开），λ=3 → 净 −1（关）
    double p_open = tau_price_gate(5.0, 2.0, 1.0);
    double p_shut = tau_price_gate(5.0, 2.0, 3.0);
    if (p_open <= 0.0 || p_shut >= 0.0) { fail = 6; }

    // 一代一步的显式写法等价于多代退火（α=1.5 → 10/1.5 = 6.666…）
    double g1 = tau_generational_step(10.0, 1.0);
    if (g1 < 6.666 || g1 > 6.667) { fail = 3; }

    return fail;
}