define %QObject* @chaos_drift(%QObject* %arg0, double %arg1) {
entry:
 %consciousness_ptr = alloca %QObject*
 %dt_ptr = alloca double
 store %QObject* %arg0, %QObject** %consciousness_ptr
 store double %arg1, double* %dt_ptr
 %1 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %1, i32 0)
 %2 = load %QObject*, %QObject** %consciousness_ptr
 %3 = load double, double* %dt_ptr
 %4 = fmul double %3, 1.61803
 call void @qk_qgate_rz(%QObject* %2, i32 0, double %4)
 %5 = load %QObject*, %QObject** %consciousness_ptr
 %6 = load double, double* %dt_ptr
 %7 = fmul double %6, 0.73205
 call void @qk_qgate_rz(%QObject* %5, i32 1, double %7)
 %8 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_cnot(%QObject* %8, i32 0, i32 1)
 %9 = load %QObject*, %QObject** %consciousness_ptr
 %10 = load double, double* %dt_ptr
 %11 = fmul double %10, 0.41421
 call void @qk_qgate_rz(%QObject* %9, i32 0, double %11)
 %12 = load %QObject*, %QObject** %consciousness_ptr
 call void @qk_qgate_h(%QObject* %12, i32 1)
 %13 = load %QObject*, %QObject** %consciousness_ptr
 ret %QObject* %13
}

define %form.EmotionReading* @measure_emotion(%QObject* %arg0) {
entry:
 %consciousness_ptr = alloca %QObject*
 %z0_ptr_1 = alloca double
 %z1_ptr_2 = alloca double
 %b0_ptr_3 = alloca i32
 %b1_ptr_7 = alloca i32
 %form_obj_10 = alloca %form.EmotionReading
 %r_ptr_11 = alloca %form.EmotionReading*
 store %QObject* %arg0, %QObject** %consciousness_ptr
 %1 = load %QObject*, %QObject** %consciousness_ptr
 %2 = call double @qk_qexpect_z(%QObject* %1, i32 0)
 store double %2, double* %z0_ptr_1
 %3 = load %QObject*, %QObject** %consciousness_ptr
 %4 = call double @qk_qexpect_z(%QObject* %3, i32 1)
 store double %4, double* %z1_ptr_2
 store i32 0, i32* %b0_ptr_3
 %5 = load double, double* %z0_ptr_1
 %6 = fcmp ogt double %5, 0.0
 br i1 %6, label %if_then_4, label %if_after_6

if_then_4:
 store i32 1, i32* %b0_ptr_3
 br label %if_after_6

if_after_6:
 store i32 0, i32* %b1_ptr_7
 %7 = load double, double* %z1_ptr_2
 %8 = fcmp ogt double %7, 0.0
 br i1 %8, label %if_then_8, label %if_after_10

if_then_8:
 store i32 1, i32* %b1_ptr_7
 br label %if_after_10

if_after_10:
 store %form.EmotionReading* %form_obj_10, %form.EmotionReading** %r_ptr_11
 %11 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_11
 %12 = load i32, i32* %b0_ptr_3
 %13 = mul i32 %12, 2
 %14 = load i32, i32* %b1_ptr_7
 %15 = add i32 %13, %14
 %16 = getelementptr %form.EmotionReading, %form.EmotionReading* %11, i32 0, i32 1
 store i32 %15, i32* %16
 %17 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_11
 %18 = load %QObject*, %QObject** %consciousness_ptr
 %19 = getelementptr %form.EmotionReading, %form.EmotionReading* %17, i32 0, i32 2
 store %QObject* %18, %QObject** %19
 %20 = load %form.EmotionReading*, %form.EmotionReading** %r_ptr_11
 ret %form.EmotionReading* %20
}

define %form.EmotionPolicy* @init_policy() {
entry:
 %form_obj_2 = alloca %form.EmotionPolicy
 %p_ptr_12 = alloca %form.EmotionPolicy*
 store %form.EmotionPolicy* %form_obj_2, %form.EmotionPolicy** %p_ptr_12
 %3 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_12
 %4 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %3, i32 0, i32 1
 store double 0.5, double* %4
 %5 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_12
 %6 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %5, i32 0, i32 2
 store double 0.5, double* %6
 %7 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_12
 %8 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %7, i32 0, i32 3
 store double 0.5, double* %8
 %9 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_12
 %10 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %9, i32 0, i32 4
 store double 0.5, double* %10
 %11 = load %form.EmotionPolicy*, %form.EmotionPolicy** %p_ptr_12
 ret %form.EmotionPolicy* %11
}

define i32 @decide(%form.EmotionPolicy* %arg0, i32 %arg1, double %arg2) {
entry:
 %policy_ptr = alloca %form.EmotionPolicy*
 %emotion_state_ptr = alloca i32
 %evidence_ptr = alloca double
 %threshold_ptr_13 = alloca double
 %decision_ptr_24 = alloca i32
 store %form.EmotionPolicy* %arg0, %form.EmotionPolicy** %policy_ptr
 store i32 %arg1, i32* %emotion_state_ptr
 store double %arg2, double* %evidence_ptr
 store double 0.5, double* %threshold_ptr_13
 %1 = load i32, i32* %emotion_state_ptr
 br label %route_cmp_18

route_cmp_18:
 %2 = icmp eq i32 %1, 0
 br i1 %2, label %route_path_14, label %route_cmp_19

route_cmp_19:
 %3 = icmp eq i32 %1, 1
 br i1 %3, label %route_path_15, label %route_cmp_20

route_cmp_20:
 %4 = icmp eq i32 %1, 2
 br i1 %4, label %route_path_16, label %route_cmp_21

route_cmp_21:
 %5 = icmp eq i32 %1, 3
 br i1 %5, label %route_path_17, label %route_after_23

route_path_14:
 %6 = load %form.EmotionPolicy*, %form.EmotionPolicy** %policy_ptr
 %7 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %6, i32 0, i32 1
 %8 = load double, double* %7
 store double %8, double* %threshold_ptr_13
 br label %route_after_23

route_path_15:
 %9 = load %form.EmotionPolicy*, %form.EmotionPolicy** %policy_ptr
 %10 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %9, i32 0, i32 2
 %11 = load double, double* %10
 store double %11, double* %threshold_ptr_13
 br label %route_after_23

route_path_16:
 %12 = load %form.EmotionPolicy*, %form.EmotionPolicy** %policy_ptr
 %13 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %12, i32 0, i32 3
 %14 = load double, double* %13
 store double %14, double* %threshold_ptr_13
 br label %route_after_23

route_path_17:
 %15 = load %form.EmotionPolicy*, %form.EmotionPolicy** %policy_ptr
 %16 = getelementptr %form.EmotionPolicy, %form.EmotionPolicy* %15, i32 0, i32 4
 %17 = load double, double* %16
 store double %17, double* %threshold_ptr_13
 br label %route_after_23

route_after_23:
 store i32 0, i32* %decision_ptr_24
 %18 = load double, double* %evidence_ptr
 %19 = load double, double* %threshold_ptr_13
 %20 = fcmp ogt double %18, %19
 br i1 %20, label %if_then_25, label %if_after_27

if_then_25:
 store i32 1, i32* %decision_ptr_24
 br label %if_after_27

if_after_27:
 %21 = load i32, i32* %decision_ptr_24
 ret i32 %21
}

define %QObject* @dream_state(double %arg0) {
entry:
 %dt_ptr = alloca double
 %world_ptr_28 = alloca %QObject*
 store double %arg0, double* %dt_ptr
 %1 = getelementptr inbounds [7 x i8], [7 x i8]* @.str.1, i64 0, i64 0
 %2 = call %QObject* @qk_encode_amplitudes(i8* %1, i32 2)
 store %QObject* %2, %QObject** %world_ptr_28
 %3 = load %QObject*, %QObject** %world_ptr_28
 %4 = load double, double* %dt_ptr
 %5 = call %QObject* @chaos_drift(%QObject* %3, double %4)
 store %QObject* %5, %QObject** %world_ptr_28
 %6 = load %QObject*, %QObject** %world_ptr_28
 ret %QObject* %6
}

define double @quality_of(%QObject* %arg0) {
entry:
 %state_ptr = alloca %QObject*
 store %QObject* %arg0, %QObject** %state_ptr
 %1 = load %QObject*, %QObject** %state_ptr
 %2 = call double @qk_qexpect_z(%QObject* %1, i32 0)
 %3 = load %QObject*, %QObject** %state_ptr
 call void @qk_release_object(%QObject* %3)
 ret double %2
}

define double @improve_drift(double %arg0, double %arg1, i32 %arg2) {
entry:
 %dt_ptr = alloca double
 %target_ptr = alloca double
 %mode_ptr = alloca i32
 %h_ptr_29 = alloca double
 %f_center_ptr_30 = alloca double
 %f_plus_ptr_31 = alloca double
 %f_minus_ptr_32 = alloca double
 %grad_ptr_33 = alloca double
 %dl_ptr_34 = alloca double
 %s0_ptr_38 = alloca %QObject*
 %s1_ptr_39 = alloca %QObject*
 %overlap_ptr_40 = alloca double
 %G_ptr_41 = alloca double
 %_s0_ptr_45 = alloca i32
 %_t0_ptr_46 = alloca i32
 store double %arg0, double* %dt_ptr
 store double %arg1, double* %target_ptr
 store i32 %arg2, i32* %mode_ptr
 store double 0.01, double* %h_ptr_29
 %1 = load double, double* %dt_ptr
 %2 = call %QObject* @dream_state(double %1)
 %3 = call double @quality_of(%QObject* %2)
 store double %3, double* %f_center_ptr_30
 %4 = load double, double* %dt_ptr
 %5 = load double, double* %h_ptr_29
 %6 = fadd double %4, %5
 %7 = call %QObject* @dream_state(double %6)
 %8 = call double @quality_of(%QObject* %7)
 store double %8, double* %f_plus_ptr_31
 %9 = load double, double* %dt_ptr
 %10 = load double, double* %h_ptr_29
 %11 = fsub double %9, %10
 %12 = call %QObject* @dream_state(double %11)
 %13 = call double @quality_of(%QObject* %12)
 store double %13, double* %f_minus_ptr_32
 %14 = load double, double* %f_plus_ptr_31
 %15 = load double, double* %f_minus_ptr_32
 %16 = fsub double %14, %15
 %17 = load double, double* %h_ptr_29
 %18 = fmul double 2.0, %17
 %19 = fdiv double %16, %18
 store double %19, double* %grad_ptr_33
 %20 = load double, double* %f_center_ptr_30
 %21 = load double, double* %target_ptr
 %22 = fsub double %20, %21
 %23 = fmul double 2.0, %22
 %24 = load double, double* %grad_ptr_33
 %25 = fmul double %23, %24
 store double %25, double* %dl_ptr_34
 %26 = load i32, i32* %mode_ptr
 %27 = icmp eq i32 %26, 0
 br i1 %27, label %if_then_35, label %if_else_36

if_then_35:
 %28 = load double, double* %dt_ptr
 %29 = load double, double* %dl_ptr_34
 %30 = fmul double 0.1, %29
 %31 = fsub double %28, %30
 ret double %31

if_else_36:
 %32 = load double, double* %dt_ptr
 %33 = call %QObject* @dream_state(double %32)
 store %QObject* %33, %QObject** %s0_ptr_38
 %34 = load double, double* %dt_ptr
 %35 = load double, double* %h_ptr_29
 %36 = fadd double %34, %35
 %37 = call %QObject* @dream_state(double %36)
 store %QObject* %37, %QObject** %s1_ptr_39
 %38 = load %QObject*, %QObject** %s0_ptr_38
 %39 = load %QObject*, %QObject** %s1_ptr_39
 %40 = call double @qk_qattention(%QObject* %38, %QObject* %39)
 store double %40, double* %overlap_ptr_40
 %41 = load double, double* %overlap_ptr_40
 %42 = fsub double 1.0, %41
 %43 = load double, double* %h_ptr_29
 %44 = load double, double* %h_ptr_29
 %45 = fmul double %43, %44
 %46 = fdiv double %42, %45
 store double %46, double* %G_ptr_41
 %47 = load double, double* %G_ptr_41
 %48 = fcmp olt double %47, 0.000001
 br i1 %48, label %if_then_42, label %if_after_44

if_then_42:
 store double 0.000001, double* %G_ptr_41
 br label %if_after_44

if_after_44:
 %49 = load %QObject*, %QObject** %s0_ptr_38
 %50 = call i32 @qk_qmeasure(%QObject* %49, i32 0)
 store i32 %50, i32* %_s0_ptr_45
 %51 = load %QObject*, %QObject** %s1_ptr_39
 %52 = call i32 @qk_qmeasure(%QObject* %51, i32 0)
 store i32 %52, i32* %_t0_ptr_46
 %53 = load double, double* %dt_ptr
 %54 = load double, double* %dl_ptr_34
 %55 = load double, double* %G_ptr_41
 %56 = fdiv double %54, %55
 %57 = fmul double 0.1, %56
 %58 = fsub double %53, %57
 %59 = load %QObject*, %QObject** %s0_ptr_38
